# Node does not auto-load this file. Export values in the hosting environment.
# Never commit credentials. Default server binds loopback only.
HOST=127.0.0.1
PORT=8787
# anthropic (default) or explicitly openai
CHAT_ENABLED=false
CHAT_PROTOCOL=anthropic
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# Existing ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL
# are fallback sources. GET /api/status never exposes these values.
# Set CHAT_ENABLED=true only after explicitly accepting provider usage charges.
